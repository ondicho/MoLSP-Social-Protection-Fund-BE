# Copy to .env; populate secrets locally. Never commit .env.
COMPOSE_PROJECT_NAME=social-assistance-fund
MYSQL_IMAGE=mysql:8.4
BUILD_IMAGE=maven:3.9-eclipse-temurin-21
RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine
APP_IMAGE=social-assistance-fund:local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
SERVER_PORT=8080
DB_NAME=social_assistance_fund
DB_USER=saf
DB_PASSWORD=
DB_ROOT_PASSWORD=
# For running outside Compose, export this URL plus DB_USER and DB_PASSWORD.
DB_URL=jdbc:mysql://localhost:3306/social_assistance_fund
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
# Generate using: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
PHONE_DEFAULT_REGION=KE
PHONE_ALLOWED_COUNTRY_CODES=254
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_PATHS=/**
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID
CORS_EXPOSED_HEADERS=X-Request-ID
CORS_MAX_AGE=3600
# LOG_PATH is for local execution; Compose uses /app/logs on a named volume.
LOG_PATH=logs
LOG_MAX_FILE_SIZE=10MB
LOG_MAX_HISTORY=14
LOG_TOTAL_SIZE_CAP=200MB
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
DB_HEALTH_INTERVAL=10s
DB_HEALTH_TIMEOUT=5s
DB_HEALTH_RETRIES=15
DB_HEALTH_START_PERIOD=40s
APP_HEALTH_INTERVAL=15s
APP_HEALTH_TIMEOUT=5s
APP_HEALTH_RETRIES=10
APP_HEALTH_START_PERIOD=60s
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
